{
  "expo": {
    "name": "skillmedha_mobileapp",
    "slug": "skillmedha-mobileapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.skillmedha.mobileapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundColor": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SkillMedha to use your camera for AI mock interviews.",
          "microphonePermission": "Allow SkillMedha to use your microphone to record interview answers.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-document-picker",
        {
          "icloudContainerEnvironment": "Production"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "9399c95e-adc4-4e5e-94e3-ecf679cea9b5"
      }
    }
  }
}
